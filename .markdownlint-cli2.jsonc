{
  "globs": [
    "**/*.md",
    "!**/node_modules/**",
    "!.github/ISSUE_TEMPLATE/*.md",
    "!.github/pull_request_template.md"
  ],
  "config": {
    "default": true,
    // Tabelas e linhas longas são comuns nos documentos de requisitos.
    "MD013": false,
    // Estilo compacto `|---|` já usado em todo o repositório.
    "MD060": false,
    // Ênfase usada como rótulo (ex.: **Pré-condições**) é intencional.
    "MD036": false,
    "MD024": { "siblings_only": true }
  }
}
