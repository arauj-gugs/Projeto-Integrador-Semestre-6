{
  "name": "fila-virtual",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24.22.0"
  },
  "scripts": {
    "check-node": "node scripts/check-node.mjs",
    "predev": "npm run check-node",
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "preup": "npm run check-node",
    "up": "npm run db:up && npm run dev",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "test": "npm test -w packages/contratos && npm test -w apps/api",
    "typecheck": "npm run typecheck -w packages/contratos && npm run typecheck -w apps/api && npm run typecheck -w apps/web",
    "test:integration": "npm run test:integration -w apps/api",
    "seed:bancada": "node scripts/seed-bancada.mjs",
    "verify:bancada-api": "node scripts/verify-bancada-api.mjs",
    "db:up": "docker compose up -d",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:seed": "npm run db:seed -w apps/api",
    "demo:local": "npm run demo:local -w apps/api",
    "build:web": "npm run build -w @fila-virtual/web"
  },
  "devDependencies": {
    "concurrently": "9.2.1"
  },
  "overrides": {
    "cookie": "1.0.2"
  }
}